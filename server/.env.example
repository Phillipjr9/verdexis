# Server
PORT=4000
NODE_ENV=production

# DATABASE: Use PostgreSQL/MySQL for production, NOT SQLite
# Example PostgreSQL (recommended):
# DATABASE_URL="postgresql://admin:password@verdexis-db.xxx.rds.amazonaws.com:5432/verdexis"
# 
# For local dev only, SQLite is fine:
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

JWT_SECRET="change-me-to-a-32-byte-random-string"
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://main.d28t5x0lqjdtjj.amplifyapp.com,https://6ourstyon7pic.kimi.page,http://localhost:5173
APP_BASE_URL=https://main.d28t5x0lqjdtjj.amplifyapp.com

# Optional: Redis for enhanced caching (falls back to in-memory if not set)
# REDIS_URL=redis://localhost:6379

# Optional: enable the LLM proxy at POST /api/ai/chat. When unset, the route
# returns 503 and the frontend falls back to its built-in rule-based answers.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional: forward orders submitted to POST /api/trades to Alpaca's paper
# trading API. When unset, trades execute against the local SQLite books only.
# ALPACA_KEY=
# ALPACA_SECRET=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional market data providers. Server-side keys are NOT exposed to the
# browser — the API proxies the requests so the keys stay private.
# ALPHA_VANTAGE_KEY=        # 25 req/day free  — historical stock prices

# Supabase backend authentication. Use the service role key for server-side
# auth lookups and user provisioning.
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...
# FINNHUB_API_KEY=          # 60 req/min free  — news + stock quotes
# TWELVE_DATA_API_KEY=      # 800 req/day free — fallback stock data
# NEWS_API_KEY=             # 100 req/day free — newsapi.org aggregator
# COINGECKO_API_KEY=        # demo key recommended on cloud hosts
# COINGECKO_API_TIER=demo   # demo | pro

# Blockchain API keys for automatic crypto deposit monitoring
# Without these, deposits must be manually approved by admins.
# ETHERSCAN_API_KEY=        # Free at https://etherscan.io/apis (5 req/sec)
# BLOCKCHAIR_API_KEY=       # Free at https://blockchair.com/api (10 req/min)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com  # Default free RPC

# Custodial withdrawal RPC endpoints and keys:
# ETHEREUM_RPC_ENDPOINT=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# ETHEREUM_WITHDRAWAL_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
# Optional Alchemy Wallet API paymaster policy for sponsored gas:
# ALCHEMY_PAYMASTER_POLICY_ID=your-paymaster-policy-id
# When this is set, the server uses wallet_prepareCalls and wallet_sendPreparedCalls
# instead of direct sendTransaction for Ethereum/BSC withdrawals.
# SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
# SOLANA_WITHDRAWAL_PRIVATE_KEY=BASE58_OR_HEX_KEYPAIR
# BSC_RPC_ENDPOINT=https://bsc.g.alchemy.com/v2/YOUR_KEY
# BSC_WITHDRAWAL_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
# BTC_WITHDRAWAL_ENABLED=false

# SMTP Email Configuration for OTP and email notifications
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-mailgun-smtp-login
# SMTP_PASS=your-mailgun-smtp-password
# SMTP_FROM=your-verified-sender@your-domain.com
# SMTP_FROM_NAME=Verdexis
# SMTP_REPLY_TO=help@your-domain.com
# SMTP_UNSUBSCRIBE_URL=https://your-domain.com/unsubscribe
# Note: Mailgun sandbox accounts can only send to authorized recipients until your domain is verified.

# SMS Configuration for OTP delivery
# Twilio Configuration
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# AWS SNS Configuration (alternative to Twilio)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# AWS Cognito Configuration (for advanced auth)
# AWS_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# AWS_COGNITO_CLIENT_ID=your-cognito-client-id
# AWS_COGNITO_CLIENT_SECRET=your-cognito-client-secret

# AWS Lambda Configuration (for serverless OTP)
# AWS_LAMBDA_OTP_FUNCTION=verdexis-otp-handler
# AWS_DYNAMODB_OTP_TABLE=verdexis-otp-codes

# Security & Session Configuration
# MAX_CONCURRENT_SESSIONS=5
# SESSION_TIMEOUT_HOURS=24
# TRUST_DEVICE_DAYS=30
# OTP_CLEANUP_INTERVAL_HOURS=1

# Fraud Detection & Risk Management
# ENABLE_FRAUD_DETECTION=true
# RISK_SCORE_THRESHOLD=60
# AUTO_BLOCK_CRITICAL_RISK=true

# Webhook Configuration for Security Events
# WEBHOOK_SECRET=your-webhook-secret
# SECURITY_WEBHOOK_URL=https://your-monitoring-system.com/webhooks/security
