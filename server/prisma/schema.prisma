generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?  @unique
  investmentId String?  @unique
  name         String
  passwordHash String
  avatar       String?
  prefs        String?
  twoFactor    Boolean  @default(false)
  role         String   @default("user")
  suspended    Boolean  @default(false)
  suspendedReason String?
  holdActive   Boolean  @default(false)
  holdType     String?
  holdReason   String?
  holdNote     String?
  holdAt       DateTime?
  kycStatus    String   @default("none")
  kycNotes     String?
  kycReviewedAt DateTime?
  kycReviewedBy String?
  kycFirstName  String?
  kycLastName   String?
  kycDob        String?
  kycCountry    String?
  kycSsnEncrypted String?
  kycAddressStreet String?
  kycAddressCity String?
  kycAddressZip String?
  kycIdDocType  String?
  kycDocumentsJson String?
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  dailyWithdrawLimit  Float?
  monthlyWithdrawLimit Float?
  dailyTransferLimit  Float?
  monthlyTransferLimit Float?
  ipAllowlist  String?
  walletAddress  String?
  walletChainId  String?
  walletProvider String?
  walletLinkedAt DateTime?
  tokenVersion Int      @default(0)
  referralCode String?  @unique
  referrerId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emailVerifications EmailVerification[]
  holdings      Holding[]
  walletBalances WalletBalance[]
  transactions  Transaction[]
  trades        Trade[]
  orders        Order[]
  resetTokens   PasswordReset[]
  watchlist     Watchlist[]
  alerts        PriceAlert[]
  notifications Notification[]
  pendingDeposits PendingDeposit[]
  walletLinks   WalletLink[]
  reviews       Review[]
  adminAudits   AdminAudit[]   @relation("AdminActor")
  audited       AdminAudit[]   @relation("AdminTarget")
  referrals     Referral[]     @relation("Referrer")
  referralBonuses ReferralBonus[]
  dcaSchedules  DcaSchedule[]
  passkeys      Passkey[]
  
  // Copy Trading relationships
  traderProfile TraderProfile?
  followers     CopyRelationship[] @relation("Trader")
  following     CopyRelationship[] @relation("Follower")
  copyTrades    CopyTrade[]
}

model WalletLink {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address     String
  chainId     String?
  provider    String?
  label       String?
  isPrimary   Boolean  @default(false)
  linkedAt    DateTime @default(now())

  @@unique([userId, address])
  @@index([userId, isPrimary])
}

model PendingDeposit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  txHash      String   @unique
  chainId     String
  toAddress   String
  fromAddress String
  asset       String
  amount      Float
  status      String   @default("pending")
  note        String?
  creditedTxId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Holding {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  name      String
  amount    Float
  avgPrice  Float
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId])
}

model WalletBalance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  String
  symbol    String
  balance   Float    @default(0)
  available Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, currency])
  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  currency    String
  amount      Float
  status      String   @default("completed")
  reference   String?
  reversedFromId String?
  subType     String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([reversedFromId])
}

model Trade {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  side      String
  amount    Float
  price     Float
  total     Float
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Order {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol           String
  side             String
  type             String
  status           String   @default("open")
  basePrice        Float
  amount           Float
  filledAmount     Float    @default(0)
  limitPrice       Float?
  stopPrice        Float?
  trailAmount      Float?
  trailType        String?
  takeProfitPrice  Float?
  stopLossPrice    Float?
  timeInForce      String   @default("GTC")
  parentOrderId    String?
  expiresAt        DateTime?
  filledAt         DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([symbol, status])
  @@index([parentOrderId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  name      String
  type      String   @default("crypto")
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
  @@index([userId])
}

model PriceAlert {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol     String
  name       String
  direction  String
  target     Float
  active     Boolean  @default(true)
  triggered  Boolean  @default(false)
  triggeredAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, active])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AdminAudit {
  id           String   @id @default(cuid())
  actorId      String
  actor        User     @relation("AdminActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUserId String?
  target       User?    @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  payload      String?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  text      String
  authorName   String
  authorAvatar String?
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved, createdAt])
}

model Referral {
  id        String   @id @default(cuid())
  referrerId String
  referrer   User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId  String
  refereeEmail String
  status    String   @default("pending")
  firstDepositAt DateTime?
  firstDepositAmount Float?
  referrerBonusUsd Float?
  refereeBonusUsd  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId, createdAt])
  @@index([refereeEmail])
  @@index([status])
}

model ReferralBonus {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Float
  bonusType    String
  paymentMethod String  @default("trading_credit")
  status       String   @default("pending")
  creditedAt   DateTime?
  creditedTransactionId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model DcaSchedule {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset         String
  assetId       String
  name          String
  amountUsd     Float
  intervalDays  Int
  active        Boolean  @default(true)
  totalInvested Float    @default(0)
  totalAcquired Float    @default(0)
  runs          Int      @default(0)
  lastRunAt     DateTime?
  nextRunAt     DateTime
  lastSkipReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([active, nextRunAt])
}

model Passkey {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId     String   @unique
  publicKey        String
  counter          Int      @default(0)
  transports       String?
  deviceName       String?
  lastUsedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([userId])
}

// Copy Trading Models
model TraderProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  bio             String?
  isPublic        Boolean  @default(false)
  allowCopying    Boolean  @default(false)
  minCopyAmount   Float    @default(100)
  maxCopiers      Int      @default(100)
  performanceFee  Float    @default(0)
  totalPnl        Float    @default(0)
  totalPnlPercent Float    @default(0)
  roi30d          Float    @default(0)
  roi90d          Float    @default(0)
  roisAllTime     Float    @default(0)
  winRate         Float    @default(0)
  totalTrades     Int      @default(0)
  totalCopiers    Int      @default(0)
  activeCopiers   Int      @default(0)
  rank            Int?
  verified        Boolean  @default(false)
  lastTradeAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublic, allowCopying])
  @@index([roi30d])
  @@index([rank])
}

model CopyRelationship {
  id              String   @id @default(cuid())
  followerId      String
  follower        User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  traderId        String
  trader          User     @relation("Trader", fields: [traderId], references: [id], onDelete: Cascade)
  allocationUsd   Float
  allocationPercent Float  @default(100)
  status          String   @default("active")
  totalCopied     Float    @default(0)
  totalPnl        Float    @default(0)
  totalPnlPercent Float    @default(0)
  copyCount       Int      @default(0)
  pausedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([followerId, traderId])
  @@index([followerId, status])
  @@index([traderId, status])
}

model CopyTrade {
  id              String   @id @default(cuid())
  followerId      String
  follower        User     @relation(fields: [followerId], references: [id], onDelete: Cascade)
  traderId        String
  traderTradeId   String
  symbol          String
  side            String
  amount          Float
  price           Float
  total           Float
  pnl             Float    @default(0)
  pnlPercent      Float    @default(0)
  status          String   @default("executed")
  createdAt       DateTime @default(now())

  @@index([followerId, createdAt])
  @@index([traderId, createdAt])
  @@index([traderTradeId])
}
