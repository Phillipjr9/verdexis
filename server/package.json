{
  "name": "verdexis-server",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/generate-prisma-client.mjs && tsx watch src/index.ts",
    "build": "node scripts/restore-wallet.mjs && node scripts/patch-user-money-emails.mjs && node scripts/patch-wallet-deposit-alerts.mjs && node scripts/restore-createApp.mjs && node scripts/generate-prisma-client.mjs && npx tsc -p tsconfig.json --skipLibCheck",
    "start": "bash scripts/prestart.sh && node dist/index.js",
    "token-registry-agent": "tsx src/scripts/tokenRegistryAgent.ts",
    "start:migrate": "bash scripts/prestart.sh && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "promote-admin": "tsx scripts/promote-admin.ts",
    "list-admins": "tsx scripts/promote-admin.ts --list",
    "init-super-admin": "tsx scripts/create-super-admin.mjs",
    "create-admin": "tsx scripts/create-admin.mjs",
    "test-admin-hierarchy": "tsx scripts/test-admin-hierarchy.mjs",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1090.0",
    "@aws-sdk/client-rds": "^3.1068.0",
    "@firebase/app": "0.16.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^7.84.0",
    "@simplewebauthn/server": "^13.3.1",
    "@simplewebauthn/types": "^12.0.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.43.0",
    "@types/aws-sdk": "^0.0.42",
    "@types/nodemailer": "^8.0.1",
    "aws-sdk": "^1.18.0",
    "aws-serverless-express": "^3.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.15",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "resend": "^4.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.12",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
