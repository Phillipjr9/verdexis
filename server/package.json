{
  "name": "verdexis-server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/restore-admin-ts.mjs && node scripts/generate-prisma-client.mjs && tsx watch src/index.ts",
    "build": "node scripts/restore-admin-ts.mjs && node scripts/generate-prisma-client.mjs && npx tsc -p tsconfig.json --skipLibCheck",
    "start": "bash scripts/prestart.sh && node dist/index.js",
    "token-registry-agent": "tsx src/scripts/tokenRegistryAgent.ts",
    "start:migrate": "bash scripts/prestart.sh && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "promote-admin": "tsx scripts/promote-admin.ts",
    "list-admins": "tsx scripts/promote-admin.ts --list",
    "init-super-admin": "tsx scripts/create-super-admin.mjs",
    "create-admin": "tsx scripts/create-admin.mjs",
    "test-admin-hierarchy": "tsx scripts/test-admin-hierarchy.mjs",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1090.0",
    "@aws-sdk/client-rds": "^3.1068.0",
    "@firebase/app": "0.16.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^7.84.0",
    "@simplewebauthn/server": "^13.3.1",
    "@simplewebauthn/types": "^12.0.0",
    "@solana/spl-token": "^0.1.8",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.43.0",
    "@types/aws-sdk": "^0.0.42",
    "@types/nodemailer": "^8.0.1",
    "aws-sdk": "^1.18.0",
    "aws-serverless-express": "^3.4.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.4",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "twilio": "^6.0.2",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@sentry/integrations": "^7.84.0",
    "@types/ws": "^8.5.8",
    "ioredis": "^5.3.2",
    "prisma": "^5.22.0"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "uuid": "^14.0.0"
  }
}
