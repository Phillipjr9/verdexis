# VERDEXIS Custody Wallet Environment Configuration
# Copy this to server/.env and fill in your values
# ⚠️ NEVER commit this file to git - add to .gitignore

# ============ ETHEREUM CUSTODY ============
# Private key of the custody wallet (keep secure!)
# Format: 0x followed by 64 hex characters
# Get from: ethers wallet create, cast wallet new, or export from MetaMask
ETHEREUM_WITHDRAWAL_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# RPC endpoint (get from Alchemy, Infura, QuickNode, etc.)
# Examples:
#   Alchemy:   https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
#   Infura:    https://mainnet.infura.io/v3/YOUR_API_KEY
#   QuickNode: https://eth-mainnet.quiknode.pro/YOUR_TOKEN/
ETHEREUM_RPC_ENDPOINT=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# Optional Alchemy BSO raw tx submit endpoint for signed transaction submission
# ALCHEMY_BSO_ENDPOINT=https://eth-mainnet.g.alchemy.com/v1/bso/submit
# Optional BSO ID required by Alchemy BSO submit
# BSO_ID=08fb5ed9-dd71-4684-a02f-56b177240058

# Optional: Custody wallet address (will be derived from private key if not set)
# ETHEREUM_WITHDRAWAL_ADDRESS=0x1234567890123456789012345678901234567890

# ============ SOLANA CUSTODY ============
# Private key of the custody wallet (base58 format from keypair.json)
# Get from: solana-keygen new
SOLANA_WITHDRAWAL_PRIVATE_KEY=

# RPC endpoint (get from QuickNode, Helius, Magic Eden, etc.)
# Examples:
#   QuickNode: https://api.YOUR-PLAN.quiknode.pro/YOUR_TOKEN/
#   Helius:    https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   Solana:    https://api.mainnet-beta.solana.com (rate-limited, not recommended for prod)
SOLANA_RPC_ENDPOINT=

# ============ BSC CUSTODY ============
# Private key of the custody wallet (same format as Ethereum)
# BSC_WITHDRAWAL_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
# RPC endpoint for BSC
# BSC_RPC_ENDPOINT=https://bsc-dataseed.binance.org/

# ============ BITCOIN CUSTODY ============
# Bitcoin withdrawals are manual unless BTC_WITHDRAWAL_ENABLED=true
# Set to true only if you have a BTC payout flow configured.
BTC_WITHDRAWAL_ENABLED=false

# Optional: Custody wallet address (will be derived from private key if not set)
# SOLANA_WITHDRAWAL_ADDRESS=

# ============ DATABASE ============
DATABASE_URL=postgresql://user:password@host:port/database

# ============ AUTHENTICATION ============
# JWT secret (minimum 16 characters, random string)
JWT_SECRET=your_secure_jwt_secret_here_minimum_16_chars

# ============ APPLICATION ============
NODE_ENV=production
CORS_ORIGIN=https://verdexis.vercel.app
APP_BASE_URL=https://verdexis.vercel.app

# ============ EXTERNAL SERVICES (Optional) ============
# CoinGecko API key (for market data)
COINGECKO_API_KEY=

# Alpha Vantage API key (for stock prices)
ALPHA_VANTAGE_KEY=

# ============ WITHDRAWAL CONFIGURATION ============
# Daily withdrawal limit per user (in USD)
# WITHDRAWAL_DAILY_LIMIT=10000

# Monthly withdrawal limit per user (in USD)
# WITHDRAWAL_MONTHLY_LIMIT=50000

# Processing fee percentage
# WITHDRAWAL_FEE_PERCENT=1
