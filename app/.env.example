# VERDEXIS - Frontend environment variables
# Copy to `.env.local` and fill in your free API keys.
# All Vite client-side env vars MUST be prefixed with VITE_.

# Public, low-privilege market key only if you intentionally need browser-side
# access for non-admin public endpoints. Do not store admin/full-privilege keys
# in the frontend. The app should normally talk to the backend proxy instead.
VITE_PUBLIC_MARKET_KEY=

# Backend API base URL.
# Leave blank (or omit) to use the Vite dev proxy (/api → http://localhost:4000).
# For production on Vercel, set to your domain: https://your-project.vercel.app/api
# For local dev with external backend, use: http://your-backend-url:4000
# For production on Elastic Beanstalk, use: https://your-eb-domain.elasticbeanstalk.com/api
VITE_API_URL=

# CoinGecko public endpoints work without a key; only set this if you have a paid CoinGecko API key for higher rate limits.
# VITE_COINGECKO_KEY=

# WalletConnect / Reown Cloud project ID. Free at https://cloud.reown.com.
# Public-by-design — every dapp embeds theirs in the client bundle.
VITE_WC_PROJECT_ID=

# Supabase client configuration for email/password auth
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase Web SDK config for Google sign-in
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps API key for signup address autocomplete (Place Picker).
# Uses the Extended Component Library:
#   https://ajax.googleapis.com/ajax/libs/@googlemaps/extended-component-library/...
# Enable in Google Cloud: Maps JavaScript API + Places API (New recommended).
# Restrict the key by HTTP referrer, e.g.:
#   https://www.verdexisgroup.com/*
#   http://localhost:5173/*
# IMPORTANT: This is a VITE_ build-time variable. Set it on the FRONTEND host
# (Vercel / Cloudflare Pages), then REDEPLOY so it is inlined into the bundle.
# Setting it only on Render (API) will not enable autocomplete in the browser.
VITE_GOOGLE_MAPS_API_KEY=
