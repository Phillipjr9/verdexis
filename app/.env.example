# VERDEXIS - Frontend environment variables
# Copy to `.env.local` and fill in your free API keys.
# All Vite client-side env vars MUST be prefixed with VITE_.

# Alpha Vantage — https://www.alphavantage.co/support/#api-key  (25 calls/day free)
VITE_ALPHA_VANTAGE_KEY=

# Finnhub — https://finnhub.io/register  (60 calls/min free)
VITE_FINNHUB_KEY=

# Backend API base URL. 
# Leave blank (or omit) to use the Vite dev proxy (/api → http://localhost:4000).
# For production on Vercel, set to your domain: https://your-project.vercel.app/api
# For local dev with external backend, use: http://your-backend-url:4000
VITE_API_URL=

# CoinGecko public endpoints work without a key; only set this if you have a paid CoinGecko API key for higher rate limits.
# VITE_COINGECKO_KEY=

# WalletConnect / Reown Cloud project ID. Free at https://cloud.reown.com.
# Public-by-design — every dapp embeds theirs in the client bundle.
VITE_WC_PROJECT_ID=

