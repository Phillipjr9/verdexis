# Production environment variables for deployed frontend.
# Keep client-side values public-only; sensitive credentials stay in the server environment.

# Backend API URL for production.
# Leave blank to use the current host and the Vercel proxy at /api, which forwards
# to the Render backend. Hardcoding example.com breaks all auth requests.
VITE_API_URL=

# Public-only / non-sensitive frontend config
VITE_PUBLIC_MARKET_KEY=
VITE_WC_PROJECT_ID=

# Firebase configuration (replace with your real public config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
