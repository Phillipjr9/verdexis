# Production environment variables for deployed frontend.
# Keep client-side values public-only; sensitive credentials stay in the server environment.

# Backend API URL - points to Render.com deployed backend
VITE_API_URL=https://example.com

# Public-only / non-sensitive frontend config
VITE_PUBLIC_MARKET_KEY=
VITE_WC_PROJECT_ID=

# Firebase configuration (replace with your real public config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
