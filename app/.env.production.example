# Frontend production environment variables
# Copy this to .env.production.local and fill in your values.
# NEVER commit real values — this file is a template only.

# Your Render backend URL — no trailing slash
# e.g. https://verdexis-backend.onrender.com
VITE_API_URL=https://verdexis-backend.onrender.com

# WalletConnect project ID — free at https://cloud.reown.com
VITE_WC_PROJECT_ID=

# Optional market data keys (server-side keys are preferred — set these on Render instead)
VITE_ALPHA_VANTAGE_KEY=
VITE_FINNHUB_KEY=
