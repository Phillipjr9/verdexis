# Frontend production environment variables
# Copy this to .env.production.local and fill in your values.
# NEVER commit real values — this file is a template only.

# Backend API URL for the deployed frontend — no trailing slash.
# Recommended: leave BLANK so the browser calls same-origin /api and the Vercel
# proxy (api/index.ts) forwards to the Render backend. Only set an absolute URL
# to bypass the proxy and hit the backend directly (this then requires CORS).
# The live backend is: https://verdexis-fjqz.onrender.com
VITE_API_URL=

# WalletConnect project ID — free at https://cloud.reown.com
VITE_WC_PROJECT_ID=

# Public, low-privilege market key only if you intentionally need browser-side
# access for non-admin public endpoints. Admin and full-access keys stay server-side.
VITE_PUBLIC_MARKET_KEY=
