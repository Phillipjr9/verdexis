{
  "version": 2,
  "buildCommand": "npm --prefix app run build",
  "outputDirectory": "app/dist",
  "builds": [
    {
      "src": "api/[...path].ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/[...path].ts"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
