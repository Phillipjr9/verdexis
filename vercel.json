{
  "$schema": "http://json-schema.org/draft-04/vercel",
  "version": 2,
  "builds": [
    {
      "src": "api/[!path].ts",
      "use": "@vercel/node"
    },
    {
      "src": "app/dist",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "^/static/(.*)",
      "dest": "/app/dist/static/$1"
    },
    {
      "src": "^/.*",
      "dest": "/app/dist/index.html"
    }
  ]
}
