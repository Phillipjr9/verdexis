{
  "name": "verdexis",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:app\"",
    "dev:app": "npm --prefix app run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix server run build && npm --prefix app run build",
    "install:all": "npm --prefix app install && npm --prefix server install",
    "db:migrate": "npm --prefix server run prisma:migrate"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.23.0",
    "@aws-amplify/backend-cli": "^1.8.3",
    "@vercel/node": "^3.2.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ai": "^6.0.196",
    "aws-amplify": "^6.17.0",
    "verdexis-server": "file:server"
  },
  "overrides": {
    "glob": "^11.1.0",
    "rimraf": "^5.0.10",
    "tar": "^6.2.1",
    "are-we-there-yet": "^4.0.0",
    "npmlog": "^7.0.0",
    "gauge": "^5.0.0"
  }
}
